# ── Azure Bot Framework ──────────────────────────────────────────────────────
MicrosoftAppId=your-azure-app-id
MicrosoftAppPassword=your-azure-app-password
PORT=3978

# ── ELK / Elasticsearch ───────────────────────────────────────────────────────
ELK_HOST=https://your-elk-host:9200
ELK_API_KEY=your-elk-api-key
ELK_INDEX=logs-*
ELK_TIMEOUT=30

# ── Your Refinement Model ─────────────────────────────────────────────────────
MODEL_API_URL=http://your-model-host/analyze
MODEL_API_KEY=your-model-api-key
MODEL_TIMEOUT=60

# ── Session Config ────────────────────────────────────────────────────────────
SESSION_TTL=1800      # seconds — 30 min default

# ── Redis (optional — remove to use in-memory sessions) ───────────────────────
# REDIS_URL=redis://localhost:6379
